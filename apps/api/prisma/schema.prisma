// SAHA eContract – schema nền tảng
// Quy ước: mọi bảng nghiệp vụ có tenantId; backend luôn lấy tenantId từ JWT, không lấy từ payload.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Tenant & Subscription ─────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model Plan {
  id               String         @id @default(uuid()) @db.Uuid
  code             String         @unique
  name             String
  maxUsers         Int
  maxContractsYear Int
  storageQuotaMb   Int
  priceMonthly     Decimal        @default(0) @db.Decimal(18, 2)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  subscriptions    Subscription[]
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @db.Uuid
  planId    String             @db.Uuid
  status    SubscriptionStatus @default(TRIAL)
  startsAt  DateTime
  endsAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  plan      Plan               @relation(fields: [planId], references: [id])

  @@index([tenantId])
}

model Tenant {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique
  name          String
  taxCode       String?
  address       String?
  email         String?
  phone         String?
  status        TenantStatus       @default(ACTIVE)
  settings      Json               @default("{}")
  storageUsedMb Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  users         User[]
  branches      Branch[]
  departments   Department[]
  roles         Role[]
  partners      Partner[]
  contracts     Contract[]
  contractTypes ContractType[]
  sequences     NumberSequence[]
  auditLogs     AuditLog[]
  subscriptions Subscription[]
  documents     ContractDocument[]
  templates     ContractTemplate[]
  clauses       Clause[]
  workflows     ApprovalWorkflow[]
}

// ───────────────────────────── Tổ chức & Người dùng ─────────────────────────────

model Branch {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  code        String
  name        String
  address     String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  departments Department[]
  users       User[]

  @@unique([tenantId, code])
}

model Department {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  branchId  String?      @db.Uuid
  parentId  String?      @db.Uuid
  code      String
  name      String
  managerId String?      @db.Uuid
  manager   User?        @relation("DepartmentManager", fields: [managerId], references: [id])
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  branch    Branch?      @relation(fields: [branchId], references: [id])
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentTree")
  users     User[]       @relation("UserDepartment")
  contracts Contract[]

  @@unique([tenantId, code])
}

enum UserStatus {
  ACTIVE
  INVITED
  LOCKED
  DISABLED
}

model User {
  id                  String                    @id @default(uuid()) @db.Uuid
  tenantId            String                    @db.Uuid
  email               String
  passwordHash        String
  fullName            String
  phone               String?
  jobTitle            String?
  departmentId        String?                   @db.Uuid
  branchId            String?                   @db.Uuid
  status              UserStatus                @default(ACTIVE)
  isPlatformAdmin     Boolean                   @default(false)
  failedLogins        Int                       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  tenant              Tenant                    @relation(fields: [tenantId], references: [id])
  department          Department?               @relation("UserDepartment", fields: [departmentId], references: [id])
  branch              Branch?                   @relation(fields: [branchId], references: [id])
  roles               UserRole[]
  sessions            Session[]
  ownedContracts      Contract[]                @relation("ContractOwner")
  createdContracts    Contract[]                @relation("ContractCreator")
  uploadedDocuments   ContractDocument[]
  createdTemplates    ContractTemplate[]        @relation("TemplateCreator")
  templateVersions    ContractTemplateVersion[]
  createdClauses      Clause[]                  @relation("ClauseCreator")
  approvedClauses     Clause[]                  @relation("ClauseApprover")
  clauseVersions      ClauseVersion[]
  managedDepartments  Department[]              @relation("DepartmentManager")
  approvalTasks       ApprovalTask[]
  signatureRequests   SignatureRequest[]
  signerAssignments   Signer[]
  assignedObligations ContractObligation[]
  notifications       Notification[]
  approvalRequests    ApprovalRequest[]

  @@unique([tenantId, email])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  code        String
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, code])
}

model RolePermission {
  roleId     String @db.Uuid
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// Refresh token dạng rotation; chỉ lưu hash.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Nhật ký hoạt động (append-only) ─────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  actorId    String?  @db.Uuid
  actorName  String?
  action     String
  entityType String
  entityId   String?
  data       Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
}

// ───────────────────────────── Đánh số tự động ─────────────────────────────

// key ví dụ: "contract:HDMB:2026" – tăng nguyên tử bằng UPSERT ... RETURNING
model NumberSequence {
  tenantId  String   @db.Uuid
  key       String
  current   Int      @default(0)
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
}

// ───────────────────────────── Đối tác ─────────────────────────────

enum PartnerType {
  CUSTOMER
  SUPPLIER
  OTHER
}

enum LegalEntityType {
  ORGANIZATION
  INDIVIDUAL
}

model Partner {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  code            String
  type            PartnerType
  entityType      LegalEntityType  @default(ORGANIZATION)
  name            String
  taxCode         String?
  idNumber        String?
  address         String?
  email           String?
  phone           String?
  representative  String?
  position        String?
  externalRef     String?
  note            String?
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  contacts        PartnerContact[]
  contractParties ContractParty[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
}

model PartnerContact {
  id        String   @id @default(uuid()) @db.Uuid
  partnerId String   @db.Uuid
  fullName  String
  position  String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Hợp đồng ─────────────────────────────

model ContractType {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  code        String
  name        String
  // Mẫu mã: hỗ trợ {TYPE} {DEPT} {BRANCH} {YYYY} {YY} {MM} {SEQUENCE} {SEQUENCE:5}
  codePattern String             @default("HD-{YYYY}-{SEQUENCE:5}")
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  contracts   Contract[]
  templates   ContractTemplate[]

  @@unique([tenantId, code])
}

enum ContractStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PENDING_SIGNATURE
  SIGNED
  ACTIVE
  EXPIRED
  LIQUIDATED
  CANCELLED
  ARCHIVED
}

enum ApprovalStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum SignatureStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  REJECTED
  EXPIRED
}

enum Confidentiality {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  SECRET
}

model Contract {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @db.Uuid
  code              String
  title             String
  contractTypeId    String?              @db.Uuid
  group             String?
  description       String?
  value             Decimal              @default(0) @db.Decimal(20, 2)
  currency          String               @default("VND")
  vatRate           Decimal?             @db.Decimal(5, 2)
  expectedSignDate  DateTime?            @db.Date
  signedDate        DateTime?            @db.Date
  effectiveDate     DateTime?            @db.Date
  expiryDate        DateTime?            @db.Date
  departmentId      String?              @db.Uuid
  ownerId           String?              @db.Uuid
  confidentiality   Confidentiality      @default(INTERNAL)
  tags              String[]             @default([])
  note              String?
  status            ContractStatus       @default(DRAFT)
  approvalStatus    ApprovalStatus       @default(NOT_SUBMITTED)
  signatureStatus   SignatureStatus      @default(NOT_STARTED)
  contentHtml       String?
  createdById       String               @db.Uuid
  archivedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  tenant            Tenant               @relation(fields: [tenantId], references: [id])
  contractType      ContractType?        @relation(fields: [contractTypeId], references: [id])
  department        Department?          @relation(fields: [departmentId], references: [id])
  owner             User?                @relation("ContractOwner", fields: [ownerId], references: [id])
  createdBy         User                 @relation("ContractCreator", fields: [createdById], references: [id])
  documents         ContractDocument[]
  templateId        String?              @db.Uuid
  templateVersion   Int?
  template          ContractTemplate?    @relation(fields: [templateId], references: [id])
  approvalRequests  ApprovalRequest[]
  signatureRequests SignatureRequest[]
  appendices        ContractAppendix[]
  obligations       ContractObligation[]
  payments          PaymentInstallment[]
  acceptances       ContractAcceptance[]
  liquidatedAt      DateTime?
  liquidationNote   String?
  parties           ContractParty[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, expiryDate])
  @@index([tenantId, ownerId])
}

enum PartyRole {
  PARTY_A
  PARTY_B
  PARTY_C
  RELATED
}

model ContractParty {
  id               String          @id @default(uuid()) @db.Uuid
  contractId       String          @db.Uuid
  partnerId        String?         @db.Uuid
  role             PartyRole
  sortOrder        Int             @default(0)
  isInternal       Boolean         @default(false)
  entityType       LegalEntityType @default(ORGANIZATION)
  name             String
  taxCode          String?
  address          String?
  email            String?
  phone            String?
  representative   String?
  position         String?
  authorizationRef String?
  contract         Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  partner          Partner?        @relation(fields: [partnerId], references: [id])

  @@index([contractId])
}

// ───────────────────────────── Tài liệu hợp đồng ─────────────────────────────

enum DocumentKind {
  MAIN
  ATTACHMENT
}

enum ScanStatus {
  NOT_SCANNED
  CLEAN
  INFECTED
}

model ContractDocument {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  contractId   String       @db.Uuid
  kind         DocumentKind @default(ATTACHMENT)
  fileName     String
  mimeType     String
  size         Int
  sha256       String
  version      Int          @default(1)
  storageKey   String       @unique
  scanStatus   ScanStatus   @default(NOT_SCANNED)
  uploadedById String       @db.Uuid
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  @@index([tenantId, contractId])
}

// ───────────────────────────── Mẫu hợp đồng ─────────────────────────────

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ContractTemplate {
  id                String                    @id @default(uuid()) @db.Uuid
  tenantId          String                    @db.Uuid
  code              String
  name              String
  contractTypeId    String?                   @db.Uuid
  description       String?
  contentHtml       String                    @default("")
  // Biến bắt buộc phải có dữ liệu khi lập hợp đồng từ mẫu.
  requiredVariables String[]                  @default([])
  // Phòng ban được dùng mẫu; rỗng = mọi phòng ban.
  departmentIds     String[]                  @default([]) @db.Uuid
  version           Int                       @default(1)
  status            TemplateStatus            @default(DRAFT)
  createdById       String                    @db.Uuid
  deletedAt         DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  tenant            Tenant                    @relation(fields: [tenantId], references: [id])
  contractType      ContractType?             @relation(fields: [contractTypeId], references: [id])
  createdBy         User                      @relation("TemplateCreator", fields: [createdById], references: [id])
  versions          ContractTemplateVersion[]
  contracts         Contract[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

// Ảnh chụp nội dung mỗi khi nội dung mẫu thay đổi.
model ContractTemplateVersion {
  id          String           @id @default(uuid()) @db.Uuid
  templateId  String           @db.Uuid
  version     Int
  contentHtml String
  createdById String           @db.Uuid
  createdAt   DateTime         @default(now())
  template    ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy   User             @relation(fields: [createdById], references: [id])

  @@unique([templateId, version])
}

// ───────────────────────────── Thư viện điều khoản ─────────────────────────────

enum ClauseCategory {
  PAYMENT
  WARRANTY
  CONFIDENTIALITY
  PENALTY
  COMPENSATION
  TERMINATION
  DISPUTE
  FORCE_MAJEURE
  OTHER
}

enum ClauseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

model Clause {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @db.Uuid
  code         String
  title        String
  category     ClauseCategory
  contentHtml  String
  version      Int             @default(1)
  status       ClauseStatus    @default(DRAFT)
  reviewNote   String?
  createdById  String          @db.Uuid
  approvedById String?         @db.Uuid
  approvedAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  createdBy    User            @relation("ClauseCreator", fields: [createdById], references: [id])
  approvedBy   User?           @relation("ClauseApprover", fields: [approvedById], references: [id])
  versions     ClauseVersion[]

  @@unique([tenantId, code])
  @@index([tenantId, category, status])
}

model ClauseVersion {
  id          String   @id @default(uuid()) @db.Uuid
  clauseId    String   @db.Uuid
  version     Int
  title       String
  contentHtml String
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  clause      Clause   @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@unique([clauseId, version])
}

// ───────────────────────────── Quy trình phê duyệt ─────────────────────────────

// Quy trình áp dụng khi hợp đồng thỏa điều kiện (loại HĐ, khoảng giá trị); chọn quy trình có priority nhỏ nhất.
model ApprovalWorkflow {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  name            String
  description     String?
  isActive        Boolean           @default(true)
  priority        Int               @default(100)
  // Điều kiện: rỗng = mọi loại hợp đồng.
  contractTypeIds String[]          @default([]) @db.Uuid
  // Khoảng giá trị [minValue, maxValue) theo đơn vị tiền của hợp đồng; null = không giới hạn.
  minValue        Decimal?          @db.Decimal(20, 2)
  maxValue        Decimal?          @db.Decimal(20, 2)
  steps           Json
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  requests        ApprovalRequest[]

  @@index([tenantId, isActive])
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  CANCELLED
}

// Một lần gửi phê duyệt; lưu ảnh chụp các bước tại thời điểm gửi.
model ApprovalRequest {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @db.Uuid
  contractId    String                @db.Uuid
  workflowId    String                @db.Uuid
  workflowName  String
  status        ApprovalRequestStatus @default(PENDING)
  currentStep   Int                   @default(1)
  totalSteps    Int
  // Ảnh chụp các bước đã giải quyết người duyệt tại thời điểm gửi.
  stepsSnapshot Json
  submittedById String                @db.Uuid
  submitNote    String?
  submittedAt   DateTime              @default(now())
  completedAt   DateTime?
  contract      Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  workflow      ApprovalWorkflow      @relation(fields: [workflowId], references: [id])
  submittedBy   User                  @relation(fields: [submittedById], references: [id])
  tasks         ApprovalTask[]

  @@index([tenantId, contractId])
}

enum ApprovalTaskStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SKIPPED
}

enum ApprovalMode {
  ALL
  ANY
}

model ApprovalTask {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @db.Uuid
  requestId  String             @db.Uuid
  stepOrder  Int
  stepName   String
  mode       ApprovalMode
  approverId String             @db.Uuid
  status     ApprovalTaskStatus
  comment    String?
  dueAt      DateTime?
  decidedAt  DateTime?
  createdAt  DateTime           @default(now())
  request    ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver   User               @relation(fields: [approverId], references: [id])

  @@index([tenantId, approverId, status])
  @@index([requestId, stepOrder])
}

// ───────────────────────────── Ký điện tử ─────────────────────────────

enum SignatureRequestStatus {
  IN_PROGRESS
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED
}

enum SigningOrder {
  SEQUENTIAL
  PARALLEL
}

// Một lượt gửi ký. Nội dung được đóng băng (contentSnapshot) và băm SHA-256 để làm bằng chứng toàn vẹn.
model SignatureRequest {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @db.Uuid
  contractId      String                 @db.Uuid
  // Mã nhà cung cấp chữ ký (INTERNAL = chữ ký điện tử nội bộ: mật khẩu / OTP email).
  provider        String                 @default("INTERNAL")
  status          SignatureRequestStatus @default(IN_PROGRESS)
  signingOrder    SigningOrder           @default(SEQUENTIAL)
  message         String?
  contentSnapshot String
  documentHash    String
  expiresAt       DateTime
  createdById     String                 @db.Uuid
  createdAt       DateTime               @default(now())
  completedAt     DateTime?
  contract        Contract               @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdBy       User                   @relation(fields: [createdById], references: [id])
  signers         Signer[]

  @@index([tenantId, status])
  @@index([contractId])
}

enum SignerStatus {
  WAITING
  PENDING
  SIGNED
  REJECTED
  SKIPPED
}

enum SignMethod {
  INTERNAL_PASSWORD
  EMAIL_OTP
}

model Signer {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  requestId      String           @db.Uuid
  order          Int
  partyRole      PartyRole?
  name           String
  email          String
  title          String?
  // Người ký nội bộ (đăng nhập hệ thống); null = người ký bên ngoài qua liên kết + OTP.
  userId         String?          @db.Uuid
  method         SignMethod
  status         SignerStatus
  // Liên kết ký bên ngoài: chỉ lưu hash của token.
  tokenHash      String?          @unique
  otpHash        String?
  otpExpiresAt   DateTime?
  otpSentAt      DateTime?
  otpAttempts    Int              @default(0)
  signatureImage String?
  signedAt       DateTime?
  signedHash     String?
  ip             String?
  userAgent      String?
  rejectReason   String?
  createdAt      DateTime         @default(now())
  request        SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id])

  @@index([tenantId, userId, status])
  @@index([requestId, order])
}

// ───────────────────────────── Vòng đời hợp đồng ─────────────────────────────

enum AppendixKind {
  AMENDMENT
  EXTENSION
  OTHER
}

enum AppendixStatus {
  DRAFT
  EFFECTIVE
  CANCELLED
}

// Phụ lục / gia hạn. Khi chuyển "Có hiệu lực": gia hạn ⇒ cập nhật ngày hết hạn; thay đổi giá trị ⇒ cộng vào giá trị HĐ.
model ContractAppendix {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  contractId    String         @db.Uuid
  seq           Int
  code          String
  title         String
  kind          AppendixKind
  contentHtml   String?
  valueChange   Decimal?       @db.Decimal(20, 2)
  newExpiryDate DateTime?      @db.Date
  effectiveDate DateTime?      @db.Date
  status        AppendixStatus @default(DRAFT)
  appliedAt     DateTime?
  createdById   String         @db.Uuid
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contract      Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, seq])
  @@index([tenantId, status])
}

enum ObligationStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model ContractObligation {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  contractId  String           @db.Uuid
  title       String
  description String?
  partyRole   PartyRole?
  assigneeId  String?          @db.Uuid
  dueDate     DateTime?        @db.Date
  progress    Int              @default(0)
  status      ObligationStatus @default(OPEN)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  contract    Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  assignee    User?            @relation(fields: [assigneeId], references: [id])

  @@index([tenantId, status, dueDate])
  @@index([contractId])
}

enum PaymentStatus {
  PLANNED
  PARTIAL
  PAID
  CANCELLED
}

model PaymentInstallment {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @db.Uuid
  contractId String        @db.Uuid
  seq        Int
  title      String
  amount     Decimal       @db.Decimal(20, 2)
  dueDate    DateTime?     @db.Date
  paidAmount Decimal       @default(0) @db.Decimal(20, 2)
  paidDate   DateTime?     @db.Date
  invoiceNo  String?
  status     PaymentStatus @default(PLANNED)
  note       String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  contract   Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, dueDate])
  @@index([contractId])
}

enum AcceptanceResult {
  PASSED
  CONDITIONAL
  FAILED
}

model ContractAcceptance {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  contractId   String           @db.Uuid
  title        String
  acceptedDate DateTime         @db.Date
  result       AcceptanceResult
  note         String?
  createdById  String           @db.Uuid
  createdAt    DateTime         @default(now())
  contract     Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

// Chống gửi trùng nhắc hạn: mỗi khóa (ví dụ "exp:<id>:30") chỉ gửi một lần.
model ReminderLog {
  key      String   @id
  tenantId String   @db.Uuid
  sentAt   DateTime @default(now())
}

// ───────────────────────────── Thông báo trong ứng dụng ─────────────────────────────

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  // Ví dụ: approval.pending, approval.result, signature.pending, signature.result, reminder.expiry…
  type      String
  title     String
  body      String?
  // Đường dẫn nội bộ trong ứng dụng (luôn bắt đầu bằng "/").
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
