NODE_ENV=development
PORT=4000
# Docker (docker compose up -d):
DATABASE_URL="postgresql://saha:saha_dev_password@localhost:5432/saha_econtract?schema=public"
DATABASE_POOL_MAX=10
# Không có Docker: chạy `npx prisma dev -n saha -d`, dùng URL nó in ra, đặt DATABASE_POOL_MAX=1
# và SHADOW_DATABASE_URL (cùng URL nhưng cổng shadow, mặc định 51215).
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="dev-access-secret-change-me-0123456789abcdef"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=14
CORS_ORIGINS="http://localhost:3000"
STORAGE_DIR=./storage
