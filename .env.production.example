# Mẫu cấu hình production cho docker-compose.prod.yml. Sao chép thành .env.production (không commit).
# Sinh chuỗi ngẫu nhiên: openssl rand -base64 48  (với mật khẩu Postgres dùng: openssl rand -hex 24)

# Tên miền trỏ về máy chủ (bản ghi A/AAAA); Caddy tự xin chứng chỉ HTTPS.
DOMAIN=econtract.example.vn
ACME_EMAIL=admin@example.vn
APP_VERSION=latest

# Chỉ dùng chữ/số (nằm trong DATABASE_URL).
POSTGRES_PASSWORD=
DATABASE_POOL_MAX=10

# Tối thiểu 32 ký tự, ngẫu nhiên.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=14

# MinIO: tài khoản root (quản trị) và tài khoản riêng cho API.
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=
S3_BUCKET=econtract
S3_ACCESS_KEY_ID=econtract-api
S3_SECRET_ACCESS_KEY=

# SMTP bắt buộc (email mời ký, OTP, thông báo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SAHA eContract <no-reply@example.vn>"

# Khởi tạo lần đầu (chỉ dùng khi DB chưa có doanh nghiệp nào). Xóa mật khẩu sau khi đăng nhập & đổi mật khẩu.
BOOTSTRAP_TENANT_CODE=saha
BOOTSTRAP_TENANT_NAME="Công ty SAHA"
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME="Super Admin"
BOOTSTRAP_ADMIN_PASSWORD=
